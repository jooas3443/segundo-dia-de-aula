frota = []
 
 
# ==========================================
# FUNÇÃO PARA NORMALIZAR TEXTO
# ==========================================
 
def normalizar(texto):
    return texto.strip().lower()
 
 
# ==========================================
# FUNÇÃO PARA NORMALIZAR ESTADO
# ==========================================
 
def normalizar_estado(estado):
 
    estado = estado.strip().lower()
 
    estados = {
        "são paulo": "SP",
        "sao paulo": "SP",
        "sp": "SP",
 
        "paraná": "PR",
        "parana": "PR",
        "pr": "PR",
 
        "minas gerais": "MG",
        "mg": "MG",
 
        "rio de janeiro": "RJ",
        "rj": "RJ",
 
        "santa catarina": "SC",
        "sc": "SC",
 
        "rio grande do sul": "RS",
        "rs": "RS",
 
        "bahia": "BA",
        "ba": "BA",
 
        "goiás": "GO",
        "goias": "GO",
        "go": "GO"
    }
 
    if estado in estados:
        return estados[estado]
 
    return estado.upper()
 
 
# ==========================================
# FUNÇÃO PARA LER UM ANO
# ==========================================
 
def ler_ano():
 
    while True:
 
        try:
            ano = int(input("Ano do caminhão: "))
 
            if ano <= 0:
                print("Digite um ano válido!")
            else:
                return ano
 
        except ValueError:
            print("Digite apenas números para o ano!")
 
 
# ==========================================
# CADASTRAR CAMINHÃO
# ==========================================
 
def cadastrar_caminhao():
 
    print("\n========== CADASTRAR CAMINHÃO ==========")
 
    placa = input("Placa: ")
    modelo = input("Modelo: ")
    motorista = input("Motorista: ")
    cidade = input("Cidade: ")
    estado = input("Estado: ")
    carga = input("Tipo de carga: ")
 
    # NOVO:
    # Agora o ano é lido através da função
    # que possui try/except.
    ano = ler_ano()
 
    placa = normalizar(placa)
    modelo = normalizar(modelo)
    motorista = normalizar(motorista)
    cidade = normalizar(cidade)
    estado = normalizar_estado(estado)
    carga = normalizar(carga)
 
    # Verificar se a placa já existe
 
    placa_existe = False
 
    for caminhao in frota:
 
        if caminhao["placa"] == placa:
            placa_existe = True
            break
 
    if placa_existe:
        print("\nEssa placa já está cadastrada!")
        return
 
    # Criar caminhão
 
    caminhao = {
        "placa": placa,
        "modelo": modelo,
        "motorista": motorista,
        "cidade": cidade,
        "estado": estado,
        "carga": carga,
        "ano": ano
    }
 
    frota.append(caminhao)
 
    print("Caminhão cadastrado com sucesso!")
 
 
# ==========================================
# LISTAR CAMINHÕES
# ==========================================
 
def listar_caminhoes():
 
    print("\n========== LISTA DE CAMINHÕES ==========")
 
    if len(frota) == 0:
 
        print("Nenhum caminhão cadastrado.")
        return
 
    for numero in range(len(frota)):
 
        caminhao = frota[numero]
 
        print("\n-----------------------------------")
        print("Caminhão", numero + 1)
        print("Placa:", caminhao["placa"])
        print("Modelo:", caminhao["modelo"])
        print("Motorista:", caminhao["motorista"])
        print("Cidade:", caminhao["cidade"])
        print("Estado:", caminhao["estado"])
        print("Carga:", caminhao["carga"])
        print("Ano:", caminhao["ano"])
 
 
