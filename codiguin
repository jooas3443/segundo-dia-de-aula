# ==========================================
# ALTERAR CAMINHÃO
# ==========================================
 
def alterar_caminhao():
 
    print("\n========== ALTERAR CAMINHÃO ==========")
 
    placa = input("Digite a placa do caminhão: ")
    placa = normalizar(placa)
 
    caminhao_encontrado = None
 
    for caminhao in frota:
 
        if caminhao["placa"] == placa:
            caminhao_encontrado = caminhao
            break
 
    if caminhao_encontrado is None:
 
        print("\nCaminhão não encontrado.")
        return
 
    print("\nCaminhão encontrado!")
 
    print("Deixe vazio caso não queira alterar o campo.")
 
    modelo = input("Novo modelo: ")
    motorista = input("Novo motorista: ")
    cidade = input("Nova cidade: ")
    estado = input("Novo estado: ")
    carga = input("Nova carga: ")
 
    print("\nDigite o novo ano.")
    print("Se não quiser alterar, deixe vazio.")
 
    # ==========================================
    # TRATAMENTO DO ANO NA ALTERAÇÃO
    # ==========================================
 
    while True:
 
        novo_ano = input("Novo ano: ")
 
        if novo_ano == "":
            break
 
        try:
 
            novo_ano = int(novo_ano)
 
            if novo_ano <= 0:
                print("Digite um ano válido!")
 
            else:
                caminhao_encontrado["ano"] = novo_ano
                break
 
        except ValueError:
 
            print("Digite apenas números para o ano!")
 
    # Alterar os campos de texto
 
    if modelo != "":
        caminhao_encontrado["modelo"] = normalizar(modelo)
 
    if motorista != "":
        caminhao_encontrado["motorista"] = normalizar(motorista)
 
    if cidade != "":
        caminhao_encontrado["cidade"] = normalizar(cidade)
 
    if estado != "":
        caminhao_encontrado["estado"] = normalizar_estado(estado)
 
    if carga != "":
        caminhao_encontrado["carga"] = normalizar(carga)
 
    print("\nCaminhão alterado com sucesso!")
 
 
# ==========================================
# REMOVER CAMINHÃO
# ==========================================
 
def remover_caminhao():
 
    print("\n========== REMOVER CAMINHÃO ==========")
 
    placa = input("Digite a placa do caminhão: ")
    placa = normalizar(placa)
 
    caminhao_encontrado = None
 
    for caminhao in frota:
 
        if caminhao["placa"] == placa:
 
            caminhao_encontrado = caminhao
            break
 
    if caminhao_encontrado is None:
 
        print("\nCaminhão não encontrado.")
        return
 
    print("\nCaminhão encontrado!")
    print("Placa:", caminhao_encontrado["placa"])
    print("Modelo:", caminhao_encontrado["modelo"])
    print("Motorista:", caminhao_encontrado["motorista"])
 
    confirmacao = input("\nDeseja realmente remover? (S/N): ")
    confirmacao = normalizar(confirmacao)
 
    if confirmacao == "s":
 
        frota.remove(caminhao_encontrado)
 
        print("\nCaminhão removido com sucesso!")
 
    else:
 
        print("\nOperação cancelada.")
 
 
# ==========================================
# ESTATÍSTICAS
# ==========================================
 
def estatisticas():
 
    print("\n========== ESTATÍSTICAS ==========")
 
    total = len(frota)
 
    if total == 0:
 
        print("Nenhum caminhão cadastrado.")
        return
 
    quantidade_sp = 0
    quantidade_pr = 0
    quantidade_mg = 0
    quantidade_rj = 0
    outros = 0
 
    for caminhao in frota:
 
        estado = caminhao["estado"]
 
        if estado == "SP":
 
            quantidade_sp += 1
 
        elif estado == "PR":
 
            quantidade_pr += 1
 
        elif estado == "MG":
 
            quantidade_mg += 1
 
        elif estado == "RJ":
 
            quantidade_rj += 1
 
        else:
 
            outros += 1
 
    print("Total de caminhões:", total)
    print("São Paulo:", quantidade_sp)
    print("Paraná:", quantidade_pr)
    print("Minas Gerais:", quantidade_mg)
    print("Rio de Janeiro:", quantidade_rj)
    print("Outros estados:", outros)
 
 
